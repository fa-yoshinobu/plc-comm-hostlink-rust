{
  "_comment": "HostLink frame body vectors. Python and .NET must send identical ASCII frames for each entry.",
  "vectors": [
    {"id": "check_error_no",                 "command": "check_error_no",                                                                    "expected_body": "?E"},
    {"id": "query_model_kv8000a",            "command": "query_model",                                                   "response": "58",      "expected_body": "?K"},
    {"id": "confirm_operating_mode_run",     "command": "confirm_operating_mode",                                        "response": "1",       "expected_body": "?M"},
    {"id": "forced_set_r0",                  "command": "forced_set",                "device": "R0",                                        "expected_body": "ST R000"},
    {"id": "forced_reset_r0",                "command": "forced_reset",              "device": "R0",                                        "expected_body": "RS R000"},
    {"id": "read_monitor_bits",              "command": "read_monitor_bits",                                            "response": "1 0",     "expected_body": "MBR"},
    {"id": "read_monitor_words",             "command": "read_monitor_words",                                           "response": "123 456", "expected_body": "MWR"},
    {"id": "forced_set_consecutive_r0_3",     "command": "forced_set_consecutive",    "device": "R0",    "count": 3,                          "expected_body": "STS R000 3"},
    {"id": "forced_reset_consecutive_r0_3",   "command": "forced_reset_consecutive",  "device": "R0",    "count": 3,                          "expected_body": "RSS R000 3"},
    {"id": "wre_dm100_vals",                 "command": "write_consecutive_legacy",  "device": "DM100.U", "values": [7, 8],                "expected_body": "WRE DM100.U 2 7 8"},
    {"id": "wss_t0_vals",                    "command": "write_set_value_consecutive","device": "T0.D",  "values": [1000, 2000],            "expected_body": "WSS T0.D 2 1000 2000"},
    {"id": "switch_bank_3",                  "command": "switch_bank",               "bank_no": 3,                                           "expected_body": "BE 3"},
    {"id": "urd_unit1_100_2",                "command": "read_expansion_unit_buffer", "unit_no": 1, "buffer_address": 100, "count": 2, "data_format": ".U", "response": "123 456", "expected_body": "URD 01 100.U 2"},
    {"id": "uwr_unit2_200_s_vals",           "command": "write_expansion_unit_buffer","unit_no": 2, "buffer_address": 200, "values": [7, 8], "data_format": ".S", "expected_body": "UWR 02 200.S 2 7 8"},
    {"id": "rdc_dm20",                       "command": "read_comments",             "device": "DM20",                  "response": "COMMENT", "expected_body": "RDC DM20"},
    {"id": "rd_dm100",         "command": "read",                  "device": "DM100.U", "expected_body": "RD DM100.U"},
    {"id": "rds_dm100_3",      "command": "read_consecutive",      "device": "DM100.U", "count": 3,              "expected_body": "RDS DM100.U 3"},
    {"id": "wr_dm100_1234",    "command": "write",                 "device": "DM100.U", "value": 1234,           "expected_body": "WR DM100.U 1234"},
    {"id": "wrs_dm100_vals",   "command": "write_consecutive",     "device": "DM100.U", "values": [100, 200, 300],"expected_body": "WRS DM100.U 3 100 200 300"},
    {"id": "rd_r0",            "command": "read",                  "device": "R0",    "expected_body": "RD R000"},
    {"id": "rds_r0_2",         "command": "read_consecutive",      "device": "R0",    "count": 2,              "expected_body": "RDS R000 2"},
    {"id": "rd_b100",          "command": "read",                  "device": "B100",  "expected_body": "RD B100"},
    {"id": "rds_x390_32",      "command": "read_consecutive",      "device": "X390",  "count": 32,             "expected_body": "RDS X390 32"},
    {"id": "mbs_x100_2",       "command": "register_monitor_bits",  "devices": ["X100", "X101"],              "expected_body": "MBS X100 X101"},
    {"id": "mbs_m100_2",       "command": "register_monitor_bits",  "devices": ["M100", "M101"],              "expected_body": "MBS M100 M101"},
    {"id": "mws_x100",         "command": "register_monitor_words", "devices": ["X100"],                      "expected_body": "MWS X100"},
    {"id": "wr_mr500_1",       "command": "write",                 "device": "MR500", "value": 1,              "expected_body": "WR MR500 1"},
    {"id": "change_mode_run",  "command": "change_mode",           "mode": "RUN",     "expected_body": "M1"},
    {"id": "change_mode_prog", "command": "change_mode",           "mode": "PROGRAM", "expected_body": "M0"},
    {"id": "clear_error",      "command": "clear_error",                              "expected_body": "ER"},
    {"id": "set_time",         "command": "set_time",
      "args": [26, 3, 13, 22, 5, 9, 5],
      "dotnet_datetime": "2026-03-13T22:05:09",
      "expected_body": "WRT 26 03 13 22 05 09 5"},
    {"id": "rd_dm100_d",       "command": "read_format",           "device": "DM100", "data_format": ".D",     "expected_body": "RD DM100.D"},
    {"id": "rd_dm100_h",       "command": "read_format",           "device": "DM100", "data_format": ".H",     "expected_body": "RD DM100.H"},
    {"id": "rde_dm100_3",      "command": "read_consecutive_legacy","device": "DM100.U", "count": 3,             "expected_body": "RDE DM100.U 3"},
    {"id": "ws_t0_1000",       "command": "write_set_value",       "device": "T0.D",  "value": 1000,           "expected_body": "WS T0.D 1000"}
  ]
}
